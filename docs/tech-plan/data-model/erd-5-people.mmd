erDiagram
  Staff ||--o{ StaffCertificates : "Staff"
  Staff ||--o{ FitnessToWork : "ClearedBy, Staff"
  Staff ||--o{ PolicyAcknowledgements : "Staff"
  Devices ||--o{ PolicyAcknowledgements : "Device"
  Policies ||--o{ PolicyAcknowledgements : "PolicyFileId"
  PolicyAcknowledgements {
    Number ID PK "SharePoint item id"
    Text Title UK "required, PolicyFileId + Version + StaffId"
    Number PolicyFileId FK "indexed"
    Text PolicyVersion
    Lookup Staff FK "indexed"
    DateTime AcknowledgedAt
    Lookup Device FK
    Note SignatureJson
  }
  StaffCertificates {
    Number ID PK "SharePoint item id"
    Text Title "required"
    Lookup Staff FK "indexed"
    Text Issuer
    Date IssuedOn
    Date ExpiresOn "indexed"
    Link DocumentLink
  }
  FitnessToWork {
    Number ID PK "SharePoint item id"
    Text Title "required"
    Lookup Staff FK "indexed"
    Date ReportedOn
    Choice SymptomsCategory
    Date ExcludedUntil
    Lookup ClearedBy FK
    Date ClearedOn
  }
  Policies {
    Number ID PK "SharePoint item id"
    Text Title "required"
    Choice Category
    YesNo RequiresAck
    MultiChoice AppliesToRoles
    Text VersionLabel
  }
  Devices {
    Number ID PK "SharePoint item id"
  }
  Staff {
    Number ID PK "SharePoint item id"
  }
  classDef ref fill:#ebe9fb,stroke:#5b52b8,color:#1b1640
