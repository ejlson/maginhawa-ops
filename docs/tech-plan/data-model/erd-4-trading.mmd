erDiagram
  TradingDays ||--o{ Feedback : "TradingDay"
  WorkOrders ||--o{ Feedback : "WorkOrder"
  TradingDays ||--o{ TradingSessions : "TradingDay"
  Sites ||--o{ TradingSessions : "Site"
  Sites ||--o{ Staff : "HomeSite"
  TradingSessions ||--o{ Adjustments : "TradingSession"
  Sites ||--o{ Adjustments : "Site"
  ReasonCodes ||--o{ Adjustments : "ReasonCode"
  Staff ||--o{ Adjustments : "ApprovedBy, PerformedBy"
  Sites ||--o{ WorkOrders : "Site"
  Staff ||--o{ WorkOrders : "ReportedBy"
  TradingSessions ||--o{ ShiftStaff : "TradingSession"
  Staff ||--o{ ShiftStaff : "Staff"
  TradingDays ||--o{ DeliveryRefunds : "TradingDay"
  DeliveryPlatforms ||--o{ DeliveryRefunds : "Platform"
  Sites ||--o{ TradingDays : "Site"
  Staff ||--o{ TradingDays : "ApprovedBy, SubmittedBy"
  TradingDays ||--o{ DeliverySales : "TradingDay"
  DeliveryPlatforms ||--o{ DeliverySales : "Platform"
  TradingDays {
    Number ID PK "SharePoint item id"
    Text Title UK "required, SiteCode + yyyy-mm-dd"
    Lookup Site FK "indexed"
    Date BusinessDate "indexed"
    Choice Status "indexed"
    Currency WageCost
    Note NextShiftNotes
    Lookup SubmittedBy FK
    DateTime SubmittedAt
    Lookup ApprovedBy FK
    Currency TotalGross "set by flow"
    Currency TotalNet "set by flow"
    Currency DineInNet "set by flow"
    Number Covers "set by flow"
    Currency ASPHNet "set by flow"
    Number FoodPct "set by flow"
    Number DrinkPct "set by flow"
    Number WagePct "set by flow"
    Choice WageRAG "set by flow"
    Currency NetVsTarget "set by flow"
    Note CheckIssues "set by flow"
    Text CalcVersion "set by flow"
  }
  TradingSessions {
    Number ID PK "SharePoint item id"
    Text Title UK "required, SiteCode + yyyy-mm-dd + Session"
    Lookup TradingDay FK "indexed"
    Lookup Site FK "indexed"
    Date BusinessDate "indexed"
    Choice Session
    Currency Gross
    Currency ServiceCharge
    Currency Tax
    Currency DiscountsComps
    Currency FoodSales
    Currency DrinkSales
    Number BookedCovers
    Number Walkins
    Currency CashInEpos
    Currency CashCollected
    Note CashExplanation
    Currency Net "set by flow"
    Number Covers "set by flow"
    Currency CashVariance "set by flow"
  }
  Adjustments {
    Number ID PK "SharePoint item id"
    Text Title UK "required"
    Lookup TradingSession FK "indexed"
    Lookup Site FK "indexed"
    Date BusinessDate "indexed"
    Choice Kind "indexed"
    Lookup ReasonCode FK "required"
    Text GuestOrStaffName
    Text Items
    Currency SaleAmount
    Currency Amount "required"
    Text Time
    Lookup PerformedBy FK
    Lookup ApprovedBy FK
    Note Notes
  }
  DeliverySales {
    Number ID PK "SharePoint item id"
    Text Title UK "required, SiteCode + yyyy-mm-dd + Platform"
    Lookup TradingDay FK "indexed"
    Lookup Platform FK
    Currency Gross
    Currency EstimatedNet "set by flow"
    Currency ActualPayout
    Text CurrentPromotion
  }
  DeliveryRefunds {
    Number ID PK "SharePoint item id"
    Text Title
    Lookup TradingDay FK "indexed"
    Lookup Platform FK
    Currency Amount "required"
    Note Details
    Choice Issued "indexed"
  }
  ShiftStaff {
    Number ID PK "SharePoint item id"
    Text Title "required"
    Lookup TradingSession FK "indexed"
    Lookup Staff FK
    Choice Department
    Choice Position
    Number Hours
  }
  Feedback {
    Number ID PK "SharePoint item id"
    Text Title
    Lookup TradingDay FK "indexed"
    Choice Category "indexed"
    Note Body "required"
    Lookup WorkOrder FK "set by flow"
  }
  DeliveryPlatforms {
    Number ID PK "SharePoint item id"
  }
  ReasonCodes {
    Number ID PK "SharePoint item id"
  }
  Sites {
    Number ID PK "SharePoint item id"
  }
  Staff {
    Number ID PK "SharePoint item id"
  }
  WorkOrders {
    Number ID PK "SharePoint item id"
  }
  classDef ref fill:#ebe9fb,stroke:#5b52b8,color:#1b1640
  classDef chk fill:#e3f4f1,stroke:#1f6f5c,color:#0f2e27
  classDef mnt fill:#e5effa,stroke:#2d6ab0,color:#0f2440
  classDef trd fill:#e8f5e2,stroke:#3d8b37,color:#16330f
  classDef ppl fill:#fdf2df,stroke:#b7791f,color:#3d2a08
  classDef rst fill:#fde8e8,stroke:#b71c1c,color:#4a0b0b
  class TradingDays trd
  class TradingSessions trd
  class Adjustments trd
  class DeliverySales trd
  class DeliveryRefunds trd
  class ShiftStaff trd
  class Feedback trd
  class DeliveryPlatforms ref
  class ReasonCodes ref
  class Sites ref
  class Staff ref
  class WorkOrders mnt
