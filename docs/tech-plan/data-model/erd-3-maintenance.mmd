erDiagram
  Sites ||--o{ Assets : "Site"
  Contractors ||--o{ Assets : "DefaultContractor"
  Contractors ||--o{ Invoices : "Contractor"
  WorkOrders ||--o{ Invoices : "WorkOrder"
  Assets ||--o{ Invoices : "Asset"
  Staff ||--o{ Invoices : "ApprovedBy"
  Sites ||--o{ Staff : "HomeSite"
