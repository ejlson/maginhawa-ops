  classDef ppl fill:#fdf2df,stroke:#b7791f,color:#3d2a08
  classDef rst fill:#fde8e8,stroke:#b71c1c,color:#4a0b0b
  class Assets mnt
  class Contractors mnt
  class WorkOrders mnt
  class ComplianceItems mnt
  class Invoices mnt
