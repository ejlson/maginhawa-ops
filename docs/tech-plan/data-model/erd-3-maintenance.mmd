  Assets {
    Number ID PK "SharePoint item id"
    Text Title "required"
    Lookup Site FK "indexed"
    Choice Category "indexed"
    Text Make
    Text Model
    Text SerialNumber
    Text QRCode UK
    Date InstallDate
    Date WarrantyExpires "indexed"
    Lookup DefaultContractor FK
    Link PhotoUrl
    YesNo Retired
  }
  Contractors {
    Number ID PK "SharePoint item id"
    Text Title "required"
    Choice Trade "indexed"
    Text ContactName
    Text Phone
    Text Email
    Text GasSafeNumber
    Text Accreditation
  }
  WorkOrders {
    Number ID PK "SharePoint item id"
    Text Title UK "required"
    Lookup Site FK "indexed"
    Lookup Asset FK "indexed"
    Text Summary "required"
    Note Description
    Choice Source
    Number SourceResponse FK
    Choice Priority "indexed"
    Choice Status "indexed"
    Lookup Contractor FK
    Lookup ReportedBy FK
    DateTime DispatchedAt
    DateTime AttendedAt
    DateTime ResolvedAt
    Note PhotoUrls
    Note History
  }
  ComplianceItems {
    Number ID PK "SharePoint item id"
    Text Title "required"
    Lookup Site FK "indexed"
    Lookup Asset FK
    Choice RequirementCode
    Number IntervalMonths
    Date LastDone
    Date NextDue "indexed"
    Lookup Contractor FK
    Link CertificateLink
    YesNo Verified
  }
  Invoices {
    Number ID PK "SharePoint item id"
    Text Title "required"
    Lookup Contractor FK "indexed"
    Lookup WorkOrder FK "indexed"
    Lookup Asset FK "indexed"
    Date InvoiceDate "indexed"
    Currency Net
    Currency VAT
    Currency Gross
    Link DocumentLink
    Lookup ApprovedBy FK
    DateTime ExportedAt
  }
  VisitorLog {
    Number ID PK "SharePoint item id"
    Text Title "required"
    Lookup Site FK "indexed"
    Text Company
    Text Purpose
    Lookup WorkOrder FK
    DateTime SignedIn "indexed"
    DateTime SignedOut
    YesNo HealthDeclaration
  }
  Responses {
    Number ID PK "SharePoint item id"
  }
  Sites {
    Number ID PK "SharePoint item id"
  }
  Staff {
    Number ID PK "SharePoint item id"
  }
