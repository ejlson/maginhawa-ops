  ChecklistTemplates {
    Number ID PK "SharePoint item id"
    Text Title "required"
    Choice Kind "indexed"
    Number CurrentVersion
    Choice Status "indexed"
    MultiLookup Sites FK
  }
  Checkpoints {
    Number ID PK "SharePoint item id"
    Text Title "required"
    Lookup Template FK "indexed"
    Number TemplateVersion "indexed"
    Number Position
    Text Section
    Note Guidance
    Note MediaLinks
    Choice ResponseType "required"
    Note Options
    Text CheckCode
    Lookup Asset FK
    YesNo Required
    YesNo PhotoRequired
    YesNo CorrectiveActionOnFail
  }
  Schedules {
    Number ID PK "SharePoint item id"
    Text Title
    Lookup Template FK "indexed"
    Lookup Site FK "indexed"
    Text DueTime "required"
    MultiChoice Days
    Number WindowMinutes
    YesNo AutoClose
    Choice AssignedRole
    Date PausedFrom
    Date PausedUntil
  }
  ChecklistRuns {
    Number ID PK "SharePoint item id"
    Text Title UK "required, SiteCode + yyyy-mm-dd + ScheduleId"
    Lookup Site FK "indexed"
    Date BusinessDate "indexed"
    Lookup Template FK
    Number TemplateVersion
    DateTime DueAt
    Choice Status "indexed"
    Lookup CompletedBy FK
    DateTime CompletedAt
    Number DurationSeconds
    Number FailedCount "set by flow"
  }
  Responses {
    Number ID PK "SharePoint item id"
    Text Title UK "required"
    Lookup Run FK "indexed"
    Lookup Site FK "indexed"
    Date BusinessDate "indexed"
    Number CheckpointId FK
    Number ValueNumber
    Note ValueText
    YesNo Passed "indexed"
    Text ThresholdSnapshot
    Choice Source
    Link PhotoUrl
    Text PhotoSha256
    YesNo CapturedLive
    Lookup RecordedBy FK
    Lookup Device FK
    DateTime ClientRecordedAt
    Number Supersedes FK
    Text CorrectionReason
  }
  CorrectiveActions {
    Number ID PK "SharePoint item id"
    Text Title "required"
    Lookup Response FK "indexed"
    Lookup Site FK "indexed"
    Note ActionTaken
    YesNo FoodDisposed
    Choice Status "indexed"
    DateTime RecheckDue "indexed"
    Lookup WorkOrder FK
    Lookup VerifiedBy FK
  }
  DayClosures {
    Number ID PK "SharePoint item id"
    Text Title UK "required, SiteCode + yyyy-mm-dd"
    Lookup Site FK "indexed"
    Date BusinessDate "indexed"
    Lookup ClosedBy FK
    Note Stats "set by flow"
    Link ReportLink "set by flow"
  }
  HandoverNotes {
    Number ID PK "SharePoint item id"
    Text Title
    Lookup Site FK "indexed"
    Date BusinessDate "indexed"
    Note Body
    Lookup Author FK
  }
  Assets {
    Number ID PK "SharePoint item id"
  }
  Devices {
    Number ID PK "SharePoint item id"
  }
  Sites {
    Number ID PK "SharePoint item id"
  }
  Staff {
    Number ID PK "SharePoint item id"
  }
  WorkOrders {
    Number ID PK "SharePoint item id"
  }
