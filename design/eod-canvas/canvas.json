    "n-login": {
      "x": 2350,
      "y": 2324,
      "w": 390,
      "size": "m",
      "fill": "gray",
      "text": "Managers, finance and admins all sign in with their Microsoft 365 work account. Their role decides what they see: managers get Today's close, admins and finance get Head office."
    },
    "n-admin": {
      "x": 1560,
      "y": 6560,
      "w": 600,
      "size": "m",
      "fill": "gray",
      "text": "Admin and finance view. Sites sorted by net. Tap a site to see it on the right. 'Needs attention' gathers late, red and unexplained items with one-tap actions. Finance gets the same screen without Settings."
    },
    "n-trends": {
      "x": 2820,
      "y": 3120,
      "w": 390,
      "size": "m",
      "fill": "gray",
      "text": "Forecast = same weekday over the last 6 weeks, nudged by bookings and trend. Built only from the figures managers type in, so no till integration is needed. Switch between net, covers and wage %."
    },
    "n-start": {
      "x": 0,
      "y": 2880,
      "w": 390,
      "size": "m",
      "fill": "gray",
      "text": "Name, site and date come from the sign-in. A late close (after midnight) still files under the trading day. Services switched off drop their steps."
    },
    "n-cash": {
      "x": 940,
      "y": 2600,
      "w": 390,
      "size": "m",
      "fill": "gray",
      "text": "One row per note or coin: type how many, the phone's number pad appears. Values and the drawer total update as you type. The total feeds 'Counted in drawer' on the step behind it."
    },
    "n-done": {
      "x": 1880,
      "y": 2324,
      "w": 390,
      "size": "m",
      "fill": "gray",
      "text": "Says exactly where the report went. Any change after this is a logged reopen by finance."
    },
    "n-review": {
      "x": 1410,
      "y": 3200,
      "w": 390,
      "size": "m",
      "fill": "gray",
      "text": "Read like a bank statement: the day's card, anything to check, then each section as a row you tap to edit. Red blocks submit, amber only warns."
    }
  }
