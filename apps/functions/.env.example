# Server settings for the submit function. Leave empty until each piece is connected.
# Entra ID app registration (app-only access to the one SharePoint site)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# SharePoint site "Maginhawa Ops"
SHAREPOINT_SITE_ID=
# Shared mailbox the EOD summary is sent from, and who receives it
MAIL_FROM=
MAIL_TO=
# Power Automate: 1 = also add each submitted EOD to the FlowOutbox list for the "EOD submitted" flow
# (flows/MaginhawaOps). No flow URL or secret is needed: the flow reads the list.
FLOW_OUTBOX=
