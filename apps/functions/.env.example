# Server settings for the /api routes (Cloudflare Pages) and the jobs Worker. Leave empty until each
# piece is connected; until then /api answers 503 and the app keeps work on the device.
# On Cloudflare these are set in the dashboard (Settings → Variables and Secrets), Production only.

# Entra ID app registration "Maginhawa App": the server's key to SharePoint and the mailbox.
# Nobody signs in with it; people sign in with an emailed code.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# SharePoint site "Maginhawa App" (/sites/MaginhawaApp)
SHAREPOINT_SITE_ID=
# Signs the sign-in cookies and codes. At least 32 random characters, e.g. `openssl rand -base64 48`.
# Changing it signs everyone out.
SESSION_SECRET=
# Shared mailbox that sends sign-in codes and the EOD summary, and who receives the summary
MAIL_FROM=
MAIL_TO=
# Power Automate: 1 = the "EOD submitted" flow is set up (flows/MaginhawaOps). Head office then choose
# which sites use it in the report builder; only those sites' EODs go to the FlowOutbox list.
FLOW_OUTBOX=
