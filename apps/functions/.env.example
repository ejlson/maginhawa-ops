# Server settings for the submit function. Leave empty until each piece is connected.
# Entra ID app registration (app-only access to the one SharePoint site)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# SharePoint site "Maginhawa Ops"
SHAREPOINT_SITE_ID=
# Shared mailbox the EOD summary is sent from, and who receives it
MAIL_FROM=
MAIL_TO=
# Power Automate: 1 = the "EOD submitted" flow is set up (flows/MaginhawaOps). Head office then choose
# which sites use it in the report builder; only those sites' EODs go to the FlowOutbox list.
# No flow URL or secret is needed: the flow reads the list.
FLOW_OUTBOX=
